{
  "appId": "com.terlikgalaksisi.oyun",
  "appName": "Terlik Galaksisi",
  "webDir": "www",
  "backgroundColor": "#04050c",
  "loggingBehavior": "none",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false
